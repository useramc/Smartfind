DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smartfind
SECRET_KEY=change-me-to-a-long-random-string
# Vector DB: local on-disk Qdrant (default) OR a Qdrant server URL
QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://localhost:6333
# EMBED_BACKEND=sentence-transformers  (default, falls back to "hash" if unavailable) | hash
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
